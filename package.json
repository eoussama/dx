{
  "name": "@eoussama/dx",
  "type": "module",
  "version": "0.1.3",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "description": "Personal ESLint config and linting CLI, built on @antfu/eslint-config.",
  "author": "eoussama",
  "license": "MIT",
  "funding": "https://github.com/sponsors/eoussama",
  "homepage": "https://github.com/eoussama/dx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eoussama/dx.git"
  },
  "bugs": {
    "url": "https://github.com/eoussama/dx/issues"
  },
  "keywords": [
    "dx",
    "eslint",
    "eslint-config",
    "eslint-flat-config",
    "antfu",
    "lint",
    "cli",
    "tui"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "dx": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "node dist/cli.mjs lint",
    "fix": "node dist/cli.mjs fix",
    "test": "pnpm test:unit && pnpm test:cli && test:coverage",
    "test:unit": "node --import ./test/register.mjs --experimental-test-module-mocks --test \"test/unit/*.test.mjs\"",
    "test:cli": "node --test test/cli.test.mjs",
    "test:coverage": "node --import ./test/register.mjs --experimental-test-module-mocks --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=90 \"test/unit/*.test.mjs\"",
    "test:mutation": "stryker run",
    "prepack": "pnpm build",
    "check": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm build && pnpm lint && pnpm test"
  },
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "^5.6.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-svelte": ">=2.35.1",
    "svelte-eslint-parser": ">=0.37.0"
  },
  "peerDependenciesMeta": {
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "eslint-plugin-svelte": {
      "optional": true
    },
    "svelte-eslint-parser": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@clack/prompts": "^1.8.1",
    "eslint": "^10.13.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/tap-runner": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-svelte": "^3.23.1",
    "svelte": "^5.57.2",
    "svelte-eslint-parser": "^1.9.0",
    "tsdown": "^0.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
