{
  "name": "@eoussama/dx",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "description": "Personal ESLint config and linting CLI, built on @antfu/eslint-config.",
  "author": "eoussama",
  "license": "MIT",
  "funding": "https://github.com/sponsors/eoussama",
  "homepage": "https://github.com/eoussama/dx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eoussama/dx.git"
  },
  "bugs": {
    "url": "https://github.com/eoussama/dx/issues"
  },
  "keywords": [
    "dx",
    "eslint",
    "eslint-config",
    "eslint-flat-config",
    "antfu",
    "lint",
    "cli",
    "tui"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "dx": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm build && node dist/cli.mjs lint",
    "fix": "pnpm build && node dist/cli.mjs fix",
    "test": "pnpm build && node --test",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "^5.6.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-svelte": ">=2.35.1",
    "svelte-eslint-parser": ">=0.37.0"
  },
  "peerDependenciesMeta": {
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "eslint-plugin-svelte": {
      "optional": true
    },
    "svelte-eslint-parser": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@clack/prompts": "^1.8.1",
    "eslint": "^10.11.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.23.3",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-svelte": "^3.23.0",
    "svelte": "^5.57.1",
    "svelte-eslint-parser": "^1.8.1",
    "tsdown": "^0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
